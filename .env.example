# Admin database (Supabase)
ADMIN_DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
ADMIN_DATABASE_URL_POOLED="postgresql://postgres:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Local Docker database (optional for local development)
ADMIN_DB_NAME="cofactor_admin_db"
ADMIN_DB_USER="cofactor"
ADMIN_DB_PASSWORD="cofactor_admin_local"
ADMIN_DB_PORT="55434"
ADMINER_PORT="8080"
SCOUT_DB_NAME="cofactor_scout_db"
SCOUT_DB_HOST="localhost"
SCOUT_DB_PORT="55435"
SCOUT_DB_ADMIN_USER="postgres"
SCOUT_DB_ADMIN_PASSWORD="cofactor_scout_local"
SCOUT_DB_ADMIN_URL="postgresql://postgres:cofactor_scout_local@localhost:55435/cofactor_scout_db?schema=public"
SCOUT_DB_READONLY_USER="cofactor_admin_readonly"
SCOUT_DB_READONLY_PASSWORD="cofactor_admin_readonly_local"
SCOUT_DB_WRITE_USER="cofactor_admin_write"
SCOUT_DB_WRITE_PASSWORD="cofactor_admin_write_local"

# Local URL examples for Docker Postgres
# ADMIN_DATABASE_URL="postgresql://cofactor:cofactor_admin_local@localhost:55434/cofactor_admin_db?schema=public"
# ADMIN_DATABASE_URL_POOLED="postgresql://cofactor:cofactor_admin_local@localhost:55434/cofactor_admin_db?schema=public"
# SCOUT_DB_READONLY_URL="postgresql://cofactor_admin_readonly:cofactor_admin_readonly_local@localhost:55435/cofactor_scout_db?schema=public"
# SCOUT_DB_WRITE_URL="postgresql://cofactor_admin_write:cofactor_admin_write_local@localhost:55435/cofactor_scout_db?schema=public"

# Scout read-only database connection
SCOUT_DB_READONLY_URL="postgresql://cofactor_admin_readonly:[password]@db.[scout-ref].supabase.co:5432/postgres"
SCOUT_DB_WRITE_URL="postgresql://cofactor_admin_write:[password]@db.[scout-ref].supabase.co:5432/postgres"

# App
NEXTAUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"
PASSWORD_RESET_DEV_SHOW_LINK="false"

# SMTP (required for production password reset emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Cofactor Admin <no-reply@cofactor.world>"
