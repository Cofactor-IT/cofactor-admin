{
  "name": "cofactor-admin",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "start": "next start",
    "docker:up": "docker compose up -d admin-db adminer",
    "docker:up:all": "docker compose up -d admin-db scout-db adminer",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f admin-db scout-db",
    "prisma:generate": "prisma generate",
    "prisma:generate:scout": "prisma generate --schema=prisma/scout/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate && npm run prisma:generate:scout",
    "prisma:format": "prisma format",
    "prisma:format:scout": "prisma format --schema=prisma/scout/schema.prisma",
    "prisma:db-pull": "prisma db pull",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "scout:local:setup": "node scripts/setup-local-scout-db.mjs",
    "scout:readonly:test": "node scripts/test-scout-readonly.mjs",
    "scout:write:test": "node scripts/test-scout-write-scope.mjs",
    "lint": "eslint . --max-warnings=0",
    "pretype-check": "npm run prisma:generate:all",
    "type-check": "tsc --noEmit",
    "prebuild": "npm run prisma:generate:all",
    "build": "next build",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
